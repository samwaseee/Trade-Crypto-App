// Watchlist documents at users/{userId}/watchlist/{coinId} contain only:
// name (string, 1-100 chars), symbol (string, 1-20 chars),
// image (string, 0-2048 chars).
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isOwner(userId) {
      return request.auth != null && request.auth.uid == userId;
    }

    function isValidWatchlistCoin() {
      return request.resource.data.keys().hasAll(['name', 'symbol', 'image']) &&
        request.resource.data.keys().hasOnly(['name', 'symbol', 'image']) &&
        request.resource.data.name is string &&
        request.resource.data.name.size() > 0 &&
        request.resource.data.name.size() <= 100 &&
        request.resource.data.symbol is string &&
        request.resource.data.symbol.size() > 0 &&
        request.resource.data.symbol.size() <= 20 &&
        request.resource.data.image is string &&
        request.resource.data.image.size() <= 2048;
    }

    function isValidCoinId(coinId) {
      return coinId.matches('^[a-z0-9._-]{1,100}$');
    }

    function isValidAssistantMessage() {
      return request.resource.data.keys().hasAll(['role', 'text', 'createdAt']) &&
        request.resource.data.keys().hasOnly(['role', 'text', 'createdAt']) &&
        request.resource.data.role is string &&
        request.resource.data.role in ['user', 'assistant'] &&
        request.resource.data.text is string &&
        request.resource.data.text.size() > 0 &&
        request.resource.data.text.size() <= 10000 &&
        request.resource.data.createdAt is timestamp;
    }

    function isValidAssistantUsage() {
      return request.resource.data.keys().hasAll(['count']) &&
        request.resource.data.keys().hasOnly(['count']) &&
        request.resource.data.count is int &&
        request.resource.data.count >= 0 &&
        request.resource.data.count <= 100;
    }

    match /users/{userId} {
      allow read: if isOwner(userId);

      allow create: if isOwner(userId) &&
        request.resource.data.wallet == 10000 &&
        request.resource.data.keys().hasAll(['name', 'phone', 'email', 'wallet']) &&
        request.resource.data.keys().hasOnly(['name', 'phone', 'email', 'wallet']) &&
        request.resource.data.name is string &&
        request.resource.data.name.size() <= 100 &&
        request.resource.data.phone is string &&
        request.resource.data.phone.size() <= 30 &&
        request.resource.data.email is string &&
        request.resource.data.email == request.auth.token.email;

      allow update: if isOwner(userId) &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['name', 'phone', 'wallet']) &&
        request.resource.data.name is string &&
        request.resource.data.name.size() <= 100 &&
        request.resource.data.phone is string &&
        request.resource.data.phone.size() <= 30 &&
        request.resource.data.wallet is number &&
        request.resource.data.wallet >= 0 &&
        request.resource.data.wallet <= 1000000000;

      allow delete: if false;

      match /watchlist/{coinId} {
        allow read: if isOwner(userId);
        allow create, update: if isOwner(userId) && isValidCoinId(coinId) && isValidWatchlistCoin();
        allow delete: if isOwner(userId);
      }

      match /assistantMessages/{messageId} {
        allow read: if isOwner(userId);
        allow create: if isOwner(userId) && isValidAssistantMessage() &&
          request.resource.data.createdAt == request.time;
        allow update: if false;
        allow delete: if isOwner(userId);
      }

      match /assistantUsage/{day} {
        allow read: if isOwner(userId);
        allow create: if isOwner(userId) && isValidAssistantUsage() &&
          request.resource.data.count == 1;
        allow update: if isOwner(userId) && isValidAssistantUsage() &&
          resource.data.count is int &&
          resource.data.count >= 0 &&
          resource.data.count < 100 &&
          request.resource.data.count == resource.data.count + 1;
        allow delete: if false;
      }

      match /transactions/{transactionId} {
        allow read: if isOwner(userId);

        allow create: if isOwner(userId) &&
          request.resource.data.type in ['Buy', 'Sell'] &&
          request.resource.data.amount is number &&
          request.resource.data.amount > 0 &&
          request.resource.data.price is number &&
          request.resource.data.price > 0 &&
          request.resource.data.cost is number &&
          request.resource.data.cost >= 0 &&
          request.resource.data.coinId is string &&
          request.resource.data.date is string &&
          request.resource.data.keys().hasAll(['type', 'coinId', 'amount', 'price', 'cost', 'date']) &&
          request.resource.data.keys().hasOnly(['type', 'coinId', 'amount', 'price', 'cost', 'date']);

        allow update: if false;

        allow delete: if isOwner(userId);
      }
    }
  }
}
